# ===================== linkVideo em produção =====================
# No servidor: este arquivo vira o .env da pasta sistema-... .
# Preencha os campos <...> do banco. Nunca deixe APP_DEBUG=true online.

APP_NAME=linkVideo
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=America/Sao_Paulo
# Endereço onde o sistema abre, SEM barra no final:
APP_URL=https://www.agenciajohncode.com.br/sistemas/linkvideo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Banco criado no painel da hospedagem (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<nome-do-banco>
DB_USERNAME=<usuario-do-banco>
DB_PASSWORD=<senha-do-banco>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Cookies restritos a esta pasta, para não misturar com o admCel no mesmo domínio
SESSION_PATH=/sistemas/linkvideo
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Os usuários master já vêm no SQL de instalação; deixe vazio em produção.
MASTER_PASSWORD=

# Limites de upload. Se o envio de vídeo falhar com erro 413,
# diminua VIDEO_CHUNK_MB (ex.: 2).
VIDEO_MAX_MB=4096
COVER_MAX_KB=5120
VIDEO_CHUNK_MB=8

VITE_APP_NAME="${APP_NAME}"
